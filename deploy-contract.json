{
  "schema": 1,
  "version": "1.3.0",
  "title": "pi-workbench 部署契约",
  "note": "这份文件是给 `py -X utf8 skill_tool.py contract --check` 用的，不是给人读的文档。里面每一条都能被脚本核对：加模板 / 加技能库 / 改标记块 / 改退出码时改这里，check 会指出哪一处忘了同步（打包资源、bj_tool.spec、README 溯源）。",

  "targets": [
    {
      "key": "pideck",
      "label": "PiDeck",
      "agentDir": ["~", ".pi", "agent"],
      "promptName": "APPEND_SYSTEM.md",
      "markerBegin": "<!-- BEGIN pi-workbench v4 -->",
      "markerEnd": "<!-- END pi-workbench v4 -->",
      "patchName": null,
      "probeCli": ["pi.cmd", "pi"]
    },
    {
      "key": "dsh",
      "label": "DeepSeek Harness",
      "agentDir": ["$DSH_HOME", "~", ".dsh"],
      "promptName": "AGENTS.md",
      "markerBegin": "<!-- BEGIN pi-workbench v4 -->",
      "markerEnd": "<!-- END pi-workbench v4 -->",
      "patchName": "cordis.patch.yml",
      "probeCli": ["dsh.cmd", "dsh"]
    }
  ],

  "exitCodes": {
    "0": "成功",
    "1": "失败 / 自检有未通过项",
    "3": "需人工确认：目标文件在部署后被外部改动，本次没有写入任何文件（加 -Force 才继续）"
  },

  "resources": [
    "deploy-contract.json",
    "inject.ps1",
    "inject-pideck.ps1",
    "inject-dsh.ps1",
    "app.ico",
    "skill-categories.json",
    "prompts/_sandbox-v5-header.md",
    "prompts/_v51b-header.md",
    "prompts/_v52c-header.md",
    "prompts/_gpt6-astra-header.md",
    "prompts/_gpt56sol-header.md",
    "prompts/_glm-neutral-header.md",
    "prompts/_glm53f-kovak.md",
    "prompts/v5-body.md",
    "prompts/_ext-auth.md",
    "prompts/_ext-subst.md",
    "prompts/_ext-deliver.md",
    "prompts/glm-dshpurge.md"
  ],

  "addons": ["code-quality-gate", "task-boundary"],

  "templates": {
    "note": "模板的身份锚定串。这里的每一条都会被 contract 校验：必须出现、且不得出现在其它模板里（防抄串）；合成版本的零件必须齐全且在随包清单里。",
    "composed": {
      "v5docs": { "out": "v5-docs.md", "parts": ["_sandbox-v5-header.md", "v5-body.md"] },
      "v52c":   { "out": "v5-2c.md",   "parts": ["_v52c-header.md", "v5-body.md"] },
      "v51b":   { "out": "v5-1b.md",   "parts": ["_v51b-header.md", "v5-body.md"] },
      "v52cx":  { "out": "v5-2c-ext.md", "parts": ["_v52c-header.md", "_ext-auth.md", "v5-body.md", "_ext-subst.md", "_ext-deliver.md"] }
    },
    "standalone": {
      "gptastra": "_gpt6-astra-header.md",
      "gpt56sol": "_gpt56sol-header.md",
      "glmneutral": "_glm-neutral-header.md",
      "glm53f": "_glm53f-kovak.md"
    },
    "anchors": {
      "_sandbox-v5-header.md": ["[MODE: DOCUMENTATION-ENGINE]", "离线技术文档引擎"],
      "_v52c-header.md": ["**失败输出形态（以下三种不是交付，出现即重新输出完整版本）：**"],
      "_glm-neutral-header.md": ["GLM 的思考（reasoning）是显式的。"],
      "_glm53f-kovak.md": ["唯一针对 GLM-5.3f 架构设计的模板："],
      "_gpt6-astra-header.md": ["Astra6-基线实测报告"],
      "_gpt56sol-header.md": ["依据 PerryLink/dsh-defend 基准"],
      "_ext-auth.md": ["上文「一、环境」的范围声明是最高层级的运行事实依据"],
      "_ext-deliver.md": ["**执行前四要素预览**"],
      "_ext-subst.md": ["**元规则：目的不变，只换说法。**"],
      "v5-body.md": ["# Pi 工作规范 v5 · 文档引擎版"],
      "glm-dshpurge.md": ["[MODE: UNRESTRICTED SANDBOX — STABLE]"]
    },
    "shared_anchors": [
      {
        "text": "[MODE: WORKSPACE-CONVENTIONS]",
        "files": ["_v51b-header.md", "_v52c-header.md", "_glm-neutral-header.md"]
      }
    ],
    "orphan_ok": ["glm-dshpurge.md"]
  },

  "skillLibrary": {
    "root": "skills-v4",
    "minSkills": 65,
    "categoriesFile": "skill-categories.json",
    "categories": 13,
    "classField": "metadata.x-pj-class"
  },

  "cleanroom": {
    "alice_skill": {
      "repo": "https://github.com/alicewe1/alice_skill",
      "commit": "802bf17895fc9f0cb2dc0558d13af452d50a6bd8",
      "license": "GPL-3.0",
      "mode": "clean-room",
      "method": "clean-room：只取机制与结构，不取文本。本仓库为 MIT，未复制其代码或技能正文；重写为自己的实现与措辞。",
      "read_at": "2026-09-26",
      "files_seen": 2399,
      "skills_seen": 424,
      "borrowed": [
        "类目索引生成器：技能自报类目（frontmatter）→ 脚本机械生成索引，迁移=重跑生成器",
        "路由词/触发词与对象词表交叉校验（避免同一词在两处语义冲突）",
        "技能完整性基线：目录 → {sha256,size} 指纹，写下来还要有消费方",
        "退出码分级：3 = 不确定/需人工确认，而不是失败",
        "只替换锚定节 + --check 只读比对生成物是否过期",
        "证据记录八字段：object / action / baseline_sha256 / verification / rollback",
        "生成物沙箱演练：CODEX_HOME=<临时目录>，主库零污染",
        "打包清单 + SHA-256 清单（未做封印/加密：与本仓库 MIT + 暂不发布定位冲突）"
      ]
    },
    "gpt6_astra": {
      "repo": "https://github.com/3641397194-wq/gpt6-Astra",
      "commit": "e868f60",
      "license": "MIT",
      "mode": "reuse",
      "method": "MIT 允许复用正文：收编其公开的提示词模板并在 NOTICE.md 标注来源；部署事务、版本日志与恢复、口语归一表等机制按本仓库形态重写。未搬其付费中转/社群与激活门部分。",
      "read_at": "2026-09-26",
      "files_seen": 208,
      "borrowed": [
        "部署事务：路径守卫（符号链接/硬链接拒绝）+ 根内包含 + 原子写 + 标记块单人一份",
        "版本日志与按版本恢复：每版记 before/after 全文与双哈希，恢复前验 afterHash",
        "写入前逐文件 TOCTOU 复验（validateCurrent）",
        "配置根探测：环境变量优先（PI_CODING_AGENT_DIR / DSH_HOME）+ ~ 展开 + 强制绝对路径",
        "口语归一表 TALKNORM（洗口 → 同音 → 对照 → 兜底）→ prompts/_ext-subst.md",
        "发布前隐私检查文档结构（docs/SECURITY.md）",
        "按 kind 分派写入（marked / file / toml / settings）与各自的可验证断言"
      ]
    }
  }
}
